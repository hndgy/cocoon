{
  "name": "cocoon",
  "version": "0.2.0",
  "description": "Cocoon — Claude's cozy isolated shell",
  "main": "dist/index.js",
  "bin": {
    "cocoon": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "docker",
    "container",
    "sandbox",
    "isolation",
    "cli",
    "ai",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hndgy/cocoon.git"
  },
  "homepage": "https://github.com/hndgy/cocoon",
  "bugs": {
    "url": "https://github.com/hndgy/cocoon/issues"
  },
  "type": "module",
  "dependencies": {
    "commander": "^14.0.3",
    "dockerode": "^4.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.0"
  }
}
